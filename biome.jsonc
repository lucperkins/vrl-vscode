{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      // Generated by `npm run generate`
      "!snippets/vrl.json",
      "!syntaxes/vrl.tmLanguage.json",
      // EJS templates aren't valid JSON until rendered
      "!templates",
      // Vendored from microsoft/vscode for tests
      "!test/grammars",
      // Grammar test cases, where exact columns matter
      "!test/**/*.yaml",
      "!package-lock.json"
    ]
  },
  "formatter": { "useEditorconfig": true },
  "linter": { "rules": { "preset": "recommended" } }
}
