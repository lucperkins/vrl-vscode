{
  "name": "vrl-vscode",
  "displayName": "Vector Remap Language",
  "description": "Vector Remap Language (VRL) support for VS Code",
  "version": "0.1.5",
  "publisher": "lucperkins",
  "author": {
    "name": "Luc Perkins"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucperkins/vrl-vscode"
  },
  "homepage": "https://marketplace.visualstudio.com/items?itemName=lucperkins.vrl-vscode",
  "bugs": {
    "url": "https://github.com/lucperkins/vrl-vscode/issues"
  },
  "engines": {
    "vscode": "^1.60.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "vector",
    "vrl",
    "vector remap language",
    "remap",
    "remapping",
    "transforms",
    "observability",
    "yaml"
  ],
  "files": [
    "ACKNOWLEDGMENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "language-configuration.json",
    "snippets/",
    "syntaxes/"
  ],
  "scripts": {
    "generate": "npm run generate:snippets && npm run generate:grammar",
    "generate:snippets": "ejs --data-file ./data/functions.json --output-file ./snippets/vrl.json ./templates/snippets.ejs.json",
    "generate:grammar": "ejs --data-file ./data/functions.json --output-file ./syntaxes/vrl.tmLanguage.json ./templates/vrl.tmLanguage.ejs.json",
    "check": "biome check",
    "check:generated": "npm run generate && git diff --exit-code -- snippets syntaxes",
    "format": "biome check --write",
    "test": "vscode-tmgrammar-test -g test/grammars/yaml/yaml.tmLanguage.json -g test/grammars/yaml/yaml-1.0.tmLanguage.json -g test/grammars/yaml/yaml-1.1.tmLanguage.json -g test/grammars/yaml/yaml-1.2.tmLanguage.json -g test/grammars/yaml/yaml-1.3.tmLanguage.json -g test/grammars/yaml/yaml-embedded.tmLanguage.json \"test/**/*.vrl\" \"test/**/*.yaml\"",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "contributes": {
    "languages": [
      {
        "id": "vrl",
        "aliases": [
          "Vector Remap Language",
          "VRL"
        ],
        "extensions": [
          ".vrl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vrl",
        "scopeName": "source.vrl",
        "path": "./syntaxes/vrl.tmLanguage.json"
      },
      {
        "scopeName": "yaml.vrl.injection",
        "path": "./syntaxes/vrl.yaml-injection.tmLanguage.json",
        "injectTo": [
          "source.yaml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.vrl": "vrl",
          "meta.embedded.line.vrl": "vrl"
        }
      }
    ],
    "snippets": [
      {
        "language": "vrl",
        "path": "./snippets/vrl.json"
      }
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@vscode/vsce": "^4.1.1",
    "ejs": "^7.0.2",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
